<!doctype html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Now Shine Your Aura</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main id="app">
    <section id="auth" class="screen active">
      <div class="auth card">
        <div class="logo">✦</div>
        <h1>Now Shine Your Aura</h1>
        <p>Login or create your Aura account</p>

        <div class="tabs">
          <button data-auth="login" class="active">Login</button>
          <button data-auth="register">Register</button>
        </div>

        <form id="authForm">
          <div id="registerFields" class="hidden">
            <input id="name" placeholder="Full name">
            <input id="username" placeholder="Username">
          </div>

          <input id="identity" placeholder="Email or mobile" required>
          <input id="password" type="password" placeholder="Password" required>
          <small id="authError"></small>
          <button class="primary">Continue</button>
        </form>

        <small>Frontend demo: data is saved only in this browser.</small>
      </div>
    </section>

    <section id="site" class="screen">
      <header>
        <h2>Welcome, <span id="welcome"></span> ✨</h2>
        <button id="logout" class="secondary">Logout</button>
      </header>

      <div class="stats">
        <div class="card">
          <small>Total Aura</small>
          <b id="aura">0</b>
        </div>

        <div class="card">
          <small>Level</small>
          <b id="level">1</b>
        </div>

        <div class="card">
          <small>Next level</small>
          <b id="next">1000</b>
        </div>
      </div>

      <nav>
        <button data-page="dashboard">Dashboard</button>
        <button data-page="tasks">Tasks</button>
        <button data-page="card">My Aura Card</button>
        <button data-page="admin">Admin</button>
      </nav>

      <section id="dashboard" class="page">
        <div class="card">
          <h3>Aura Dashboard</h3>
          <p>Complete assigned tasks to earn Aura points.</p>
          <button class="primary" data-page="tasks">View Tasks</button>
        </div>
      </section>

      <section id="tasks" class="page hidden">
        <div class="card">
          <h3>Assigned Tasks</h3>
          <div id="taskList"></div>
        </div>
      </section>

      <section id="card" class="page hidden">
        <div class="aura-card card">
          <div class="star">🌌</div>
          <h2 id="cardName"></h2>
          <p id="cardUser"></p>
          <h3>LEVEL <span id="cardLevel"></span></h3>
          <p>Total Aura: <b id="cardAura"></b></p>
          <p>Card No: <b id="cardNo"></b></p>

          <button class="primary" id="download">Download</button>
          <button class="primary" id="share">Share</button>
        </div>
      </section>

      <section id="admin" class="page hidden">
        <div class="card">
          <h3>Admin Demo</h3>
          <p>Create tasks and assign Aura rewards.</p>

          <input id="taskTitle" placeholder="Task title">
          <input id="taskPoints" type="number" value="100" min="1">

          <button class="primary" id="addTask">Add task</button>
        </div>
      </section>
    </section>
  </main>

  <script src="app.js"></script>
</body>
</html>
